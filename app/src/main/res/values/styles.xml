<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#74DDF3</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#041D30</item>
        <item name="android:navigationBarColor">#041D30</item>
    </style>
    <style name="GridCell">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item><item name="android:textSize">14sp</item>
        <item name="android:textColor">#F4FAFF</item><item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:maxLines">1</item>
    </style>
</resources>
