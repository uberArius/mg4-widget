<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/field_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="5dp" android:background="@drawable/tile_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/field_icon" android:layout_width="20dp" android:layout_height="20dp" android:padding="3dp" android:background="@drawable/icon_frame" android:importantForAccessibility="no"/>
  <LinearLayout android:id="@+id/field_content" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="5dp">
   <TextView android:id="@+id/field_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#DBEEF8"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/cell_0" style="@style/GridCell"/>
  <TextView android:id="@+id/cell_1" style="@style/GridCell"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/cell_2" style="@style/GridCell"/>
  <TextView android:id="@+id/cell_3" style="@style/GridCell"/>
 </LinearLayout>
 <TextView android:id="@+id/field_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#9CC2D5" android:maxLines="2"/>
</LinearLayout>